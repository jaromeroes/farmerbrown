---
/**
 * Magic-link login. Form posts to /api/auth/request-link (server-side);
 * never imports the Supabase SDK in the browser. The "Sign in" button
 * in the email goes to /auth/verify, which establishes the session
 * server-side before redirecting to /portal.
 */
import { createSupabaseServerClient } from '@lib/supabase';
import { getCustomerSession } from '@lib/auth';

export const prerender = false;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});
if (await getCustomerSession(supabase)) {
  return Astro.redirect('/portal', 307);
}

const error = Astro.url.searchParams.get('error');
const errorMessage =
  error === 'invalid-link' ? 'That sign-in link is invalid or expired. Request a new one.' :
  null;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Sign in — Farmer Brown AI Hub</title>
    <style>
      :root {
        --bg: #fafaf9; --card: #ffffff; --text: #1a1a1a;
        --muted: #6b6b6b; --border: #e5e5e5; --accent: #2563eb;
        --font: -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      }
      * { box-sizing: border-box; }
      body { margin: 0; font-family: var(--font); background: var(--bg); color: var(--text); }
      main {
        max-width: 22rem; margin: 4rem auto; padding: 2rem;
        background: var(--card); border: 1px solid var(--border); border-radius: 8px;
      }
      .brand {
        display: flex; flex-direction: column; align-items: center;
        gap: 0.5rem; margin-bottom: 1.5rem;
      }
      .brand img { height: 48px; width: auto; display: block; }
      .brand span { font-size: 0.875rem; color: var(--muted); font-weight: 500; }
      h1 { font-size: 1.25rem; margin-top: 0; }
      label { font-size: 0.875rem; color: var(--muted); }
      input[type=email] {
        width: 100%; padding: 0.625rem; border: 1px solid var(--border);
        border-radius: 6px; font: inherit; margin: 0.25rem 0 1rem;
      }
      button {
        width: 100%; background: var(--accent); color: white;
        padding: 0.625rem; border: none; border-radius: 6px;
        font: inherit; font-weight: 500; cursor: pointer;
      }
      button[disabled] { opacity: 0.5; cursor: not-allowed; }
      .msg { font-size: 0.875rem; margin-top: 1rem; }
      .msg.ok { color: #16a34a; }
      .msg.err { color: #dc2626; }
    </style>
  </head>
  <body>
    <main>
      <div class="brand">
        <img src="/farmerbrown-logo.webp" alt="Farmer Brown" width="192" height="48" />
        <span>AI Hub</span>
      </div>
      <h1>Sign in to your portal</h1>
      <p style="font-size: 0.875rem; color: var(--muted);">
        Access is restricted to authorized users. If your email is registered,
        we'll send you a sign-in link — no password required.
      </p>
      <form id="login-form">
        <label for="email">Email</label>
        <input id="email" type="email" name="email" required autocomplete="email" />
        <button id="submit" type="submit">Send link</button>
      </form>
      <p id="msg" class="msg" style="display: none;"></p>
      {errorMessage && <p class="msg err" style="display: block;">{errorMessage}</p>}
    </main>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const submit = document.getElementById('submit') as HTMLButtonElement;
      const msg = document.getElementById('msg') as HTMLElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const email = (document.getElementById('email') as HTMLInputElement).value;
        submit.disabled = true;
        msg.style.display = 'none';

        const r = await fetch('/api/auth/request-link', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email }),
        });

        if (r.status === 429) {
          msg.textContent = 'Too many requests. Try again in a minute.';
          msg.className = 'msg err';
        } else {
          msg.textContent = 'If your email is registered, you\'ll receive a sign-in link shortly. Check your inbox.';
          msg.className = 'msg ok';
        }
        msg.style.display = 'block';
        submit.disabled = false;
      });
    </script>
  </body>
</html>
