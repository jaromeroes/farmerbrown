---
/**
 * /portal/voices — Voice Lab. The customer auditions candidate agent voices
 * and sends us a shortlist.
 *
 * Two things make this more than a list of play buttons:
 *   • Every voice has a PHONE render (8 kHz, G.711 µ-law, band-passed to
 *     300–3400 Hz) next to the studio one. A browser MP3 flatters every voice;
 *     the line does not, and the line is where these agents live.
 *   • Every sample is loudness-normalised, so the loudest one doesn't win.
 *
 * The catalogue is generated by voice-agents/scripts/voice-lab-build.js and
 * carries no vendor name and no voice id — labels only. The label → vendor
 * mapping stays in voice-agents/docs/voice-lab-registry.json.
 *
 * State (picks + notes) lives in localStorage until the customer sends it;
 * nothing is persisted server-side, the shortlist arrives as an email.
 * Auth-gated like the rest of the portal.
 */
import Portal from '@layouts/Portal.astro';
import { createSupabaseServerClient } from '@lib/supabase';
import { getCustomerSession } from '@lib/auth';
import { VOICE_SAMPLES } from '@lib/voiceCatalog';

export const prerender = false;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});
const session = await getCustomerSession(supabase);
if (!session) {
  return Astro.redirect('/login', 307);
}

const accents = [...new Set(VOICE_SAMPLES.map((v) => v.accent))].sort();
---

<Portal title="Voices">
  <div class="card">
    <h2>Voice Lab</h2>
    <p class="small text-muted" style="margin-bottom:1rem;">
      {VOICE_SAMPLES.length} candidate voices for the agents on your lines —
      female, American. Listen, star the ones you like, and send us the list —
      we'll put your picks on the agents you choose.
    </p>
    <p class="small" style="margin:0;">
      <strong>Listen on <em>Phone line</em> before you decide.</strong> The
      <em>Studio</em> track is the clean recording; <em>Phone line</em> is that
      same voice pushed through a real telephone channel, which is what your
      callers actually hear. Voices often swap places between the two.
    </p>
  </div>

  <div class="card controls" role="group" aria-label="Playback and filters">
    <div class="row" style="margin-bottom:0.875rem;">
      <span class="ctl-label">Play as</span>
      <div class="seg">
        <button type="button" class="seg-btn is-on" data-mode="phone" aria-pressed="true">Phone line</button>
        <button type="button" class="seg-btn" data-mode="studio" aria-pressed="false">Studio</button>
      </div>
    </div>
    <div class="row">
      <span class="ctl-label">Show</span>
      <select id="f-accent" aria-label="Filter by accent">
        <option value="">All accents</option>
        {accents.map((a) => <option value={a}>{a}</option>)}
      </select>
      <label class="check">
        <input type="checkbox" id="f-starred" /> Starred only
      </label>
      <span class="text-muted small" id="shown-count" style="margin-left:auto;"></span>
    </div>
  </div>

  <div class="grid" id="grid">
    {VOICE_SAMPLES.map((v) => (
      <article
        class="voice"
        data-label={v.label}
        data-accent={v.accent}
        data-studio={v.studio}
        data-phone={v.phone}
      >
        <div class="voice-top">
          <button type="button" class="play" aria-label={`Play ${v.label}`}>
            <span class="ico" aria-hidden="true">▶</span>
          </button>
          <div class="voice-id">
            <span class="mono label">{v.label}</span>
            <span class="meta small text-muted">{v.accent}</span>
          </div>
          <button type="button" class="star" aria-label={`Star ${v.label}`} aria-pressed="false">★</button>
        </div>
        {v.tone && <p class="tone small text-muted">{v.tone}</p>}
      </article>
    ))}
  </div>

  <div class="card" id="send-card">
    <h2>Send your picks</h2>
    <p class="small text-muted">
      Tell us anything that helps — which agent a voice would suit, what felt
      off about the ones you skipped.
    </p>
    <textarea id="comment" rows="3" placeholder="e.g. FB-07 for the main greeting; FB-12 sounded too young on the phone."></textarea>
    <div class="row" style="margin-top:0.875rem;">
      <button type="button" class="btn" id="send" disabled>Send my picks</button>
      <span class="small text-muted" id="pick-summary">Nothing starred yet</span>
    </div>
    <p class="small" id="send-status" role="status" aria-live="polite"></p>
  </div>

  <audio id="player" preload="none"></audio>

  <style>
    .controls { position: sticky; top: 0; z-index: 5; margin-bottom: 1.5rem; }
    .ctl-label {
      font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em;
      color: var(--muted); font-weight: 600;
    }
    .seg { display: inline-flex; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    .seg-btn {
      background: white; border: none; padding: 0.4rem 0.9rem;
      font: inherit; font-size: 0.875rem; cursor: pointer; color: var(--muted);
    }
    .seg-btn + .seg-btn { border-left: 1px solid var(--border); }
    .seg-btn.is-on { background: var(--accent); color: white; }
    select {
      font: inherit; font-size: 0.875rem; padding: 0.35rem 0.5rem;
      border: 1px solid var(--border); border-radius: 6px; background: white; color: var(--text);
    }
    .check { font-size: 0.875rem; color: var(--muted); display: flex; align-items: center; gap: 0.35rem; }

    .grid {
      display: grid; gap: 0.75rem; margin-bottom: 1.5rem;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    }
    .voice {
      background: var(--card); border: 1px solid var(--border);
      border-radius: 8px; padding: 0.875rem;
    }
    .voice.is-starred { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
    .voice[hidden] { display: none; }
    .voice-top { display: flex; align-items: center; gap: 0.625rem; }
    .voice-id { min-width: 0; flex: 1; }
    .label { display: block; font-weight: 600; }
    .meta { display: block; text-transform: capitalize; }
    .play {
      flex: none; width: 34px; height: 34px; border-radius: 50%;
      border: 1px solid var(--border); background: var(--bg);
      cursor: pointer; color: var(--text); font-size: 0.8rem; line-height: 1;
    }
    .play:hover { border-color: var(--accent); color: var(--accent); }
    .voice.is-playing .play { background: var(--accent); border-color: var(--accent); color: white; }
    .star {
      flex: none; background: none; border: none; cursor: pointer;
      font-size: 1.15rem; line-height: 1; color: var(--border); padding: 0.2rem;
    }
    .star:hover { color: var(--warning); }
    .voice.is-starred .star { color: var(--warning); }
    .tone { margin: 0.625rem 0 0; }

    textarea {
      width: 100%; font: inherit; font-size: 0.9375rem; padding: 0.625rem;
      border: 1px solid var(--border); border-radius: 6px; resize: vertical; color: var(--text);
    }
    #send-status:empty { display: none; }
  </style>

  <script>
    const STORE = 'fb-voice-picks';
    const grid = document.getElementById('grid');
    const player = document.getElementById('player') as HTMLAudioElement;
    const cards = Array.from(grid!.querySelectorAll<HTMLElement>('.voice'));

    let mode: 'phone' | 'studio' = 'phone';
    let playing: HTMLElement | null = null;

    const starred = new Set<string>(
      (() => {
        try { return JSON.parse(localStorage.getItem(STORE) || '[]'); }
        catch { return []; }
      })()
    );

    // ── Playback: one voice at a time, so comparisons stay honest ──────────
    function stop() {
      player.pause();
      playing?.classList.remove('is-playing');
      playing = null;
    }

    function play(card: HTMLElement) {
      const src = card.dataset[mode];
      if (!src) return;
      if (playing === card && !player.paused) { stop(); return; }
      stop();
      player.src = src;
      player.play().catch(() => {/* autoplay blocked or file missing */});
      playing = card;
      card.classList.add('is-playing');
    }

    player.addEventListener('ended', stop);

    // ── Stars ──────────────────────────────────────────────────────────────
    function persist() {
      localStorage.setItem(STORE, JSON.stringify([...starred]));
      const n = starred.size;
      const send = document.getElementById('send') as HTMLButtonElement;
      send.disabled = n === 0;
      document.getElementById('pick-summary')!.textContent =
        n === 0 ? 'Nothing starred yet'
                : `${n} starred: ${[...starred].sort().join(', ')}`;
      applyFilters();
    }

    function toggleStar(card: HTMLElement) {
      const label = card.dataset.label!;
      const on = !starred.has(label);
      on ? starred.add(label) : starred.delete(label);
      card.classList.toggle('is-starred', on);
      card.querySelector('.star')!.setAttribute('aria-pressed', String(on));
      persist();
    }

    for (const card of cards) {
      if (starred.has(card.dataset.label!)) {
        card.classList.add('is-starred');
        card.querySelector('.star')!.setAttribute('aria-pressed', 'true');
      }
      card.querySelector('.play')!.addEventListener('click', () => play(card));
      card.querySelector('.star')!.addEventListener('click', () => toggleStar(card));
    }

    // ── Filters ────────────────────────────────────────────────────────────
    const fAccent = document.getElementById('f-accent') as HTMLSelectElement;
    const fStarred = document.getElementById('f-starred') as HTMLInputElement;

    function applyFilters() {
      let shown = 0;
      for (const card of cards) {
        const ok =
          (!fAccent.value || card.dataset.accent === fAccent.value) &&
          (!fStarred.checked || starred.has(card.dataset.label!));
        card.hidden = !ok;
        if (ok) shown++;
      }
      document.getElementById('shown-count')!.textContent =
        shown === cards.length ? `${shown} voices` : `${shown} of ${cards.length} voices`;
    }

    for (const el of [fAccent, fStarred]) {
      el.addEventListener('change', applyFilters);
    }

    // ── Studio / phone toggle ──────────────────────────────────────────────
    for (const btn of document.querySelectorAll<HTMLButtonElement>('.seg-btn')) {
      btn.addEventListener('click', () => {
        mode = btn.dataset.mode as 'phone' | 'studio';
        for (const b of document.querySelectorAll('.seg-btn')) {
          const on = b === btn;
          b.classList.toggle('is-on', on);
          b.setAttribute('aria-pressed', String(on));
        }
        // Re-play the current voice through the new channel — that A/B is the
        // whole point of having both renders.
        const current = playing;
        if (current) { stop(); play(current); }
      });
    }

    // ── Send ───────────────────────────────────────────────────────────────
    const status = document.getElementById('send-status')!;
    document.getElementById('send')!.addEventListener('click', async (e) => {
      const btn = e.currentTarget as HTMLButtonElement;
      btn.disabled = true;
      status.textContent = 'Sending…';
      status.className = 'small text-muted';
      try {
        const res = await fetch('/api/voice-lab/picks', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            labels: [...starred].sort(),
            comment: (document.getElementById('comment') as HTMLTextAreaElement).value,
          }),
        });
        if (!res.ok) throw new Error((await res.json().catch(() => ({}))).error || `HTTP ${res.status}`);
        status.textContent = 'Sent. We’ll come back to you with these on the agents.';
        status.className = 'small text-success';
      } catch (err) {
        status.textContent = `Could not send: ${(err as Error).message}. Your picks are still saved here.`;
        status.className = 'small text-danger';
        btn.disabled = false;
      }
    });

    persist();
  </script>
</Portal>
