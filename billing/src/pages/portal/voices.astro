---
/**
 * /portal/voices — the Voice Lab behind the customer's portal login.
 *
 * The gallery itself lives in components/VoiceGallery.astro; this page is
 * only the auth gate. The same gallery is also served without a login at
 * /voices/<token> for people who have the share link.
 */
import Portal from '@layouts/Portal.astro';
import VoiceGallery from '@components/VoiceGallery.astro';
import { createSupabaseServerClient } from '@lib/supabase';
import { getCustomerSession } from '@lib/auth';

export const prerender = false;

const supabase = createSupabaseServerClient({
  request: Astro.request,
  cookies: Astro.cookies,
});
const session = await getCustomerSession(supabase);
if (!session) {
  return Astro.redirect('/login', 307);
}
---

<Portal title="Voices">
  <VoiceGallery />
</Portal>
