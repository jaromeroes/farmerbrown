# =====================================================================
# Farmer Brown AI Hub — environment variables
#
# Copy to .env (gitignored) and fill in all values before running locally.
# In production, set these in Vercel project settings.
# =====================================================================

# --- Public site URL ---
# Used to build absolute URLs for Stripe success/cancel redirects and the
# magic-link verify endpoint.
# Production: https://farmerbrown.theb2btinkerers.com
PUBLIC_SITE_URL=http://localhost:4321

# --- Supabase ---
# Project URL and anon key (safe for browser).
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service role key (NEVER ship to client; server-only). Bypasses RLS, used by
# cron + webhook + checkout endpoints to mutate balances.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Stripe ---
# Test mode keys for local development; switch to live in production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook signing secret from `stripe listen` locally, or from the Stripe
# dashboard webhook config in production.
STRIPE_WEBHOOK_SECRET=whsec_...

# --- VAPI ---
# Same key used in farmerbrown agent repo. Server-only — never expose.
VAPI_KEY=...

# --- Resend (transactional email) ---
RESEND_API_KEY=re_...
# Verified sender domain (set up DNS records on this domain in Resend).
EMAIL_FROM="Farmer Brown AI Hub <notifications@farmerbrown.theb2btinkerers.com>"

# --- Cron auth ---
# Vercel cron sends Authorization: Bearer $CRON_SECRET. Must match.
# Generate with: openssl rand -hex 32
CRON_SECRET=replace-me-with-random-hex

# --- Operational ---
# Email that receives the same alerts John receives (José's inbox).
OPERATIONS_EMAIL=jaromero.es@gmail.com

# --- Builders Risk lead notifications (/api/vapi-lead-email) ---
# CSV of recipients for the BR lead-summary email. Defaults to
# jaromero.es@gmail.com if unset. Add the sales/John recipient here when ready.
# NOTE: this endpoint reuses CRON_SECRET as the VAPI webhook secret
# (set as the BR phone number's server.secret in VAPI).
LEAD_NOTIFICATION_EMAILS=jaromero.es@gmail.com
