{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@lib/*": ["src/lib/*"],
      "@components/*": ["src/components/*"],
      "@layouts/*": ["src/layouts/*"]
    },
    "types": ["astro/client", "node"]
  },
  "include": ["src/**/*", ".astro/types.d.ts", "scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
